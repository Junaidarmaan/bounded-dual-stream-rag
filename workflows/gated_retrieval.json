    {
      "parameters": {
        "jsCode": "\nconst input = $input.first().json;\nconst message = (input.chatInput || \"\").trim();\n\nconst isGreeting =\n  /^(hi|hello|hey|hii|hiii|good morning|good afternoon|good evening|howdy)[!.?,\\s]*$/i.test(message);\n\nif (isGreeting) {\n  return [{\n    json: {\n      ...input,\n      isGreeting: true,\n      greetingResponse: \"Hello! I'm here to help you with meeting-related coaching information.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    ...input,\n    isGreeting: false\n  }\n}];\n"
      },
