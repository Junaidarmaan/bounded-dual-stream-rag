        "jsCode": "\nconst voiceRows = $input.all()\n  .map(item => item.json)\n  .filter(row => row.session_id);\n\nconst frameworkRows = $('Execute a SQL query').all()\n  .map(item => item.json)\n  .filter(row => row.session_id);\n\nconst question = $('When chat message received').first().json.chatInput;\n\nreturn [\n  {\n    json: {\n      question,\n      frameworks: frameworkRows,\n      voice_samples: voiceRows\n    }\n  }\n];\n"
